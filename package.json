{
  "name": "inventario",
  "version": "0.1",
  "private": true,
  "license": "MIT",
  "description": "Sistema de inventario para la DGESYC",
  "main": "dist/server/server-principal.js",
  "types": "dist/server/server-principal.d.ts",
  "files": [
    "dist",
    "install"
  ],
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.2.0",
    "@mui/lab": "^6.0.0-beta.19",
    "@mui/material": "^6.2.0",
    "@mui/x-data-grid": "^7.23.1",
    "backend-plus": "^2.5.2-betha.23",
    "frontend-plus": "^1.0.3-alpha.1",
    "jsbarcode": "^3.12.1",
    "pg-triggers": "^0.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^7.0.2",
    "redux-typed-reducer": "^0.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",   
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "babel-loader": "^9.2.1",
    "mixin-patch": "^0.4.1",
    "source-map-loader": "^5.0.0",
    "ts-loader": "^9.5.1",
    "types.d.ts": "^0.6.22",
    "typescript": "^5.7.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0"
  },
  "mixin-patch": {},
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig-client.json && tsc -p tsconfig-server.json && tsc -p tsconfig-unlogged.json && mixin-patch && npx webpack",
    "build-ignore-error": "(tsc -p tsconfig-client.json || echo \"continue w/error\") && (tsc -p tsconfig-server.json  || echo \"continue w/error\") && (tsc -p tsconfig-unlogged.json || echo \"continue w/error\") && mixin-patch && npx webpack",
    "build-cli": "(tsc -p tsconfig-client.json || echo \"continue w/error\") && (tsc -p tsconfig-unlogged.json || echo \"continue w/error\") && mixin-patch && npx webpack",
    "watch:buildC": "tsc -p tsconfig-client.json --watch",
    "watch:buildS": "tsc -p tsconfig-server.json --watch",
    "watch:buildU": "tsc -p tsconfig-unlogged.json --watch",
    "test": "mocha --reporter spec --bail --check-leaks test/",
    "dump": "npm start -- --dump-db",
    "dumpb": "(tsc -p tsconfig-server.json  || echo \"continue w/error\") && npm run dump",
    "start": "node dist/server/server-principal.js"
  }
}
